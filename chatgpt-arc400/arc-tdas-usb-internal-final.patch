+/*
+ * Match only the SCSI host below the physical TerraMaster TDAS USB path.
+ * dev_name() on the parent chain contains both "2-3.1.4" and
+ * "2-3.1.4:1.0" (the UAS interface).
+ */
+static bool is_usb_internal_target(const struct scsi_device *sdp)
+{
+    struct device *dev;
+    const size_t path_len = strlen(USB_INTERNAL_PATH);
+
+    if (unlikely(!sdp || !sdp->host))
+        return false;
+
+    dev = sdp->host->shost_gendev.parent;
+    while (dev) {
+        const char *name = dev_name(dev);
+
+        if (name &&
+            (!strcmp(name, USB_INTERNAL_PATH) ||
+             (!strncmp(name, USB_INTERNAL_PATH, path_len) && name[path_len] == ':')))
+            return true;
+
+        dev = dev->parent;
+    }
+
+    return false;
+}
+
+/*
+ * Never modify the global UAS/usb-storage host template.  Clone it for the
+ * target Scsi_Host only, so the Arc boot USB (1-3/host0) and all other USB
+ * storage keep their original Synology port type.
+ */
+static int prepare_usb_internal_host(struct scsi_device *sdp)
+{
+    struct scsi_host_template *private_hostt;
+
+    if (!is_usb_internal_target(sdp))
+        return 0;
+
+    if (sdp->host->hostt->syno_port_type == SYNO_PORT_TYPE_SATA)
+        return 0;
+
+    private_hostt = devm_kmemdup(&sdp->host->shost_gendev,
+                                 sdp->host->hostt,
+                                 sizeof(*private_hostt),
+                                 GFP_KERNEL);
+    if (unlikely(!private_hostt)) {
+        pr_loc_err("USB internal: failed to clone SCSI host template for path %s",
+                   USB_INTERNAL_PATH);
+        return -ENOMEM;
+    }
+
+    private_hostt->syno_port_type = SYNO_PORT_TYPE_SATA;
+    sdp->host->hostt = private_hostt;
+
+    pr_loc_inf("USB internal: host%d path=%s cloned and changed to SATA port type",
+               sdp->host->host_no, USB_INTERNAL_PATH);
+    return 0;
+}
